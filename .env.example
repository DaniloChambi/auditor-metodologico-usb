# Lista de API Keys de Google AI Studio separadas por coma para rotación aleatoria
GEMINI_API_KEYS=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3

# Salt secreta de producción para el verification_hash SHA-256 (cambiar por una cadena aleatoria larga)
SECRET_SALT=USB_2026_CAMBIA_ESTA_CLAVE_SECRETA

# Puerto del servidor Node.js (si usas contenedor único en lugar de Apache/PHP)
PORT=3000
